# PostgreSQL lokal (port default 5432) — lihat docs/setup-postgresql-lokal.md
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hafiz
# Atau user postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:GANTI_PASSWORD@localhost:5432/hafiz

JWT_SECRET=change-me-in-production-hafiz
JWT_ALGORITHM=HS256
PARENT_TOKEN_EXPIRE_MINUTES=10080
CHILD_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175"]
REDIS_URL=redis://localhost:6380/0
USE_LOCAL_STORAGE=true
LOCAL_RECORDINGS_DIR=data/recordings
API_PUBLIC_BASE=http://localhost:8010
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hafiz-recordings
RECORDING_RETENTION_DAYS=365
ENVIRONMENT=development

# --- Pra-cek AI (opsional; nonaktif bawaan). Suara anak hanya dikirim jika orang tua menyetujui. ---
# Pra-cek: STT_ENABLED=true + izin di Pengaturan + tombol "Jalankan pra-cek ulang" di antrean.
STT_ENABLED=false
# openai = API cloud (OpenAI) ATAU server lokal kompatibel OpenAI (LocalAI, whisper.cpp server)
# faster_whisper = Whisper open source in-process (pip install -r requirements-stt-local.txt, FFmpeg)
STT_ENGINE=openai
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
# STT_BASE_URL=http://127.0.0.1:8080/v1
STT_MODEL=whisper-1
STT_WHISPER_MODEL=small
STT_WHISPER_DEVICE=cpu
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Pengingat murojaah (Web Push). Buat kunci: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@contoh.com
REMINDER_TIMEZONE=Asia/Jakarta
# Jalankan SATU proses: python -m app.workers.reminder_worker
